# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/helpdesk_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk_db

# JWT Authentication Secret
JWT_SECRET=helpdesk_jwt_secret_dev_key_2026_secure

# Python ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:5001
